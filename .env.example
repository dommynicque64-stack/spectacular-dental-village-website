# ---------------------------------------------------------------------------
# Spectacular Dental Village — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` (or `.env.local`) and fill in the values below.
# Restart the dev server / rebuild after changing any value.

# Optional: a real booking/contact backend endpoint that accepts a JSON POST.
# Examples:
#   https://formspree.io/f/xxxxxxxx
#   https://api.yourdomain.co.ke/appointments
#   https://script.google.com/macros/s/xxxxxxxx/exec
#
# When this is NOT set, appointment and contact requests are handed to WhatsApp
# (the clinic's verified booking channel) and the website clearly tells the
# patient that they must press "Send" in WhatsApp to complete the request.
# No false "booking confirmed" message is ever shown.
VITE_BOOKING_ENDPOINT=

# Optional: bearer token sent as `Authorization: Bearer <value>` to the endpoint.
VITE_BOOKING_API_KEY=
